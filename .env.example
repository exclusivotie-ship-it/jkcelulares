# GEMINI_API_KEY: Required for Gemini AI API calls (GladIA Intelligent Assistant).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (For production persistent database & Auth):
# Obtenha no painel do seu projeto Supabase: https://supabase.com/dashboard
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# JK STORE WHATSAPP CONFIGURATION:
VITE_JK_WHATSAPP_NUMBER="244922201011"
VITE_JK_WHATSAPP_LINK="https://wa.me/244922201011"
